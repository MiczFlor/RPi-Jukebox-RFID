FROM libzmq:local AS libzmq
FROM debian:trixie-slim

# These are only dependencies that are required to get as close to the
# Raspberry Pi environment as possible.
RUN apt-get update && apt-get install -y \
    libasound2-dev \
    pulseaudio \
    pulseaudio-utils \
    --no-install-recommends

ARG UID
ARG USER
ARG HOME
ENV INSTALLATION_PATH=${HOME}/RPi-Jukebox-RFID

# The base/macOS Compose configuration runs as root; Linux maps the host UID.
RUN case "${UID}" in \
      ''|*[!0-9]*) echo "UID must be a non-negative integer" >&2; exit 1 ;; \
    esac \
    && if [ "${UID}" -eq 0 ]; then \
         if [ "${USER}" != "root" ]; then \
           echo "UID 0 requires USER=root" >&2; \
           exit 1; \
         fi; \
       else \
         if [ -z "${USER}" ] || [ "${USER}" = "root" ]; then \
           echo "A positive UID requires a non-root USER" >&2; \
           exit 1; \
         fi; \
         useradd -m -u "${UID}" "${USER}"; \
       fi \
    && usermod -aG pulse "${USER}"

# Jukebox
# Install all Jukebox dependencies
RUN apt-get update && apt-get install -qq -y \
    --allow-downgrades --allow-remove-essential --allow-change-held-packages \
    build-essential at wget \
    espeak mpc mpg123 git ffmpeg spi-tools netcat-openbsd \
    python3 python3-venv python3-dev python3-setuptools python3-mutagen \
    swig unzip

# Build and install the lg C library from source.
# rpi-lgpio pulls in lgpio, which `requirements.txt` forces to build from source
# (`--no-binary=lgpio`) because the PyPI lgpio wheels are incomplete (armv6,
# python3.13). Mirrors
# `installation/routines/setup_jukebox_core.sh::_jukebox_core_build_and_install_lg`.
RUN mkdir -p /tmp/lg && cd /tmp/lg \
    && wget --quiet https://abyz.me.uk/lg/lg.zip \
    && unzip -q lg.zip \
    && cd lg \
    && make && make install \
    && cd / && rm -rf /tmp/lg

# Copy in the source code using the correct permissions
COPY --chown=${USER}:${USER} . ${INSTALLATION_PATH}/

# Switch to the `$USER` (typically `pi`)
USER ${USER}
WORKDIR ${HOME}

# Initialize venv
ENV VIRTUAL_ENV=${INSTALLATION_PATH}/.venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Install all Python dependencies
RUN pip install --no-cache-dir -r ${INSTALLATION_PATH}/requirements.txt

# Install pyzmq Python dependency separately
ENV ZMQ_PREFIX=/opt/libzmq
ENV ZMQ_DRAFT_API=1
COPY --from=libzmq ${ZMQ_PREFIX} ${ZMQ_PREFIX}
RUN pip install -v pyzmq --no-binary pyzmq

EXPOSE 5555 5556
WORKDIR ${INSTALLATION_PATH}/src/jukebox
